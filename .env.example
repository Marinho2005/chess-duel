# Valores padrao para executar todo o projeto via Docker Compose.
# Para rodar backend/frontend diretamente na maquina, troque DB_HOST e os hosts
# de VALKEY_URL para localhost. NUXT_PUBLIC_API_URL permanece localhost porque
# essa URL e acessada pelo navegador, mesmo quando o Nuxt roda em container.

# PostgreSQL
POSTGRES_USER=chess_duel
POSTGRES_PASSWORD=chess_duel_password
POSTGRES_DB=chess_duel_dev

# Backend (Phoenix) - conexao com o banco
# Opcional: se DATABASE_URL estiver definida, ela tem precedência sobre host/port/user separados
# DATABASE_URL=ecto://usuario:senha@host:5432/banco
DB_HOST=postgres
DB_PORT=5432
DB_USER=chess_duel
DB_PASSWORD=chess_duel_password
DB_NAME=chess_duel_dev

# Backend (Phoenix) - Valkey
# Usamos redis:// porque o Redix só reconhece esse scheme, mas aponta para o Valkey
# (protocolo compatível).
VALKEY_URL=redis://valkey:6379

# Frontend (Nuxt)
NUXT_PUBLIC_API_URL=http://localhost:4000

# OAuth (crie as credenciais manualmente nos paineis dos provedores)
# Google redirect URI: http://localhost:4000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Discord redirect URI: http://localhost:4000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# GitHub callback URL: http://localhost:4000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FRONTEND_URL=http://localhost:3000
