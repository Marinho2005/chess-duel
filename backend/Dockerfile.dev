FROM elixir:1.18.3-otp-27

ENV MIX_ENV=dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git inotify-tools nodejs npm stockfish \
    && rm -rf /var/lib/apt/lists/* \
    && mix local.hex --force \
    && mix local.rebar --force

ENV STOCKFISH_PATH=/usr/games/stockfish

WORKDIR /app

COPY mix.exs mix.lock ./
RUN mix deps.get && mix deps.compile

COPY priv/chess_validator/package.json priv/chess_validator/package-lock.json ./priv/chess_validator/
RUN npm ci --prefix priv/chess_validator

COPY . .

EXPOSE 4000

# O volume /app/deps acelera reinicios, mas pode sobreviver a um rebuild com
# mix.lock novo. Sincronizamos o volume antes de iniciar para evitar lock mismatch.
CMD ["sh", "-c", "mix deps.get && mix deps.compile && mix ecto.create && mix ecto.migrate && exec mix phx.server"]
