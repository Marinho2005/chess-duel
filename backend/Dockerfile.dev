FROM elixir:1.18.3-otp-27

ENV MIX_ENV=dev

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential ca-certificates git inotify-tools nodejs npm \
    && rm -rf /var/lib/apt/lists/* \
    && mix local.hex --force \
    && mix local.rebar --force

WORKDIR /app

COPY mix.exs mix.lock ./
RUN mix deps.get && mix deps.compile

COPY priv/chess_validator/package.json priv/chess_validator/package-lock.json ./priv/chess_validator/
RUN npm ci --prefix priv/chess_validator

COPY . .

EXPOSE 4000

CMD ["sh", "-c", "mix ecto.create && mix ecto.migrate && exec mix phx.server"]
